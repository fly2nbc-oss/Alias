# Line endings: LF in the repository and on checkout on every platform, so no
# CRLF/LF churn between machines. Windows scripts are the exception.
* text=auto eol=lf

# cmd.exe misreads labels and goto in batch files with LF line endings.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf

# Binary files: never touch their bytes.
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.odt   binary
*.ods   binary
*.odp   binary
*.xls   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.wasm  binary
*.onnx  binary
